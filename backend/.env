# Your secret settings - NEVER commit this file to GitHub!
# Copy this file to .env and fill in your actual values.

# Which port the server runs on (default: 5001)
PORT=5001

# Your MongoDB connection string
# Local MongoDB:  mongodb://localhost:27017/agrosense_indore
# MongoDB Atlas:  mongodb+srv://username:password@cluster.mongodb.net/agrosense_indore
MONGODB_URI=mongodb://localhost:27017/agrosense_indore

# Path to Python (usually python3 on Mac/Linux, python on Windows)
PYTHON_PATH=python3
